# Copy this file to .env.local and fill in the values, then restart `npm run dev`.
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/patron_tours?retryWrites=true&w=majority
# Admin login
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
# Any long random text (used to sign the login cookie)
AUTH_SECRET=change-this-to-a-long-random-string

# Enquiry emails (Gmail). Use a Gmail "App password", not the normal password.
SMTP_USER=infopatrontourandtravel99@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional: where enquiries are sent (defaults to the email in Admin > Contact & Social)
ENQUIRY_TO=
